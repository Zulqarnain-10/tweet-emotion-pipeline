# The service needs no secrets at runtime. These are optional tuning knobs.
PORT=8000
PREDICTION_LOG_PATH=
LOG_LEVEL=INFO
# Repo root the service reads params.yaml, configs/, models/, and reports/ from.
# Empty means the checkout that contains the package (the Docker image sets /app).
TWEET_EMOTION_HOME=
# HF_TOKEN is read by scripts/deploy_space.py only. Export it in the shell for a deploy;
# never write it into a file.
